@startuml ParkingSystem

' Actual implementation in com.example.parkingsystem
skinparam classAttributeIconSize 0
hide empty members

package "com.example.parkingsystem" {

    interface Command {
        +getCommandName() : String
        +getDisplayName() : String
        +execute(params : Properties) : String
    }

    enum CarType {
        COMPACT
        SUV
    }

    class Money {
        -amount : BigDecimal
        ..
        +Money(amount : BigDecimal)
        +getAmount() : BigDecimal
        +multiply(multiplier : BigDecimal) : Money
        +add(other : Money) : Money
    }

    class ParkingPermit {
        -id : String
        -car : Car
        ..
        +ParkingPermit(id : String, car : Car)
        +getId() : String
        +getCar() : Car
        +getOwner() : Customer
    }

    class ParkingLot {
        -name : String
        -baseRate : Money
        -chargeStrategyFactory : ParkingChargeStrategyFactory
        -observers : List<ParkingAction>
        ..
        +ParkingLot(name : String, baseRate : Money, factory : ParkingChargeStrategyFactory)
        +addObserver(observer : ParkingAction) : void
        +removeObserver(observer : ParkingAction) : void
        +enter(permit : ParkingPermit) : void
        +enter(permit : ParkingPermit, timestamp : LocalDateTime) : void
        +exit(permit : ParkingPermit) : void
        +exit(permit : ParkingPermit, timestamp : LocalDateTime) : void
        +getChargeStrategyFactory() : ParkingChargeStrategyFactory
        +setChargeStrategyFactory(factory : ParkingChargeStrategyFactory) : void
        +calculateCharge(entry : LocalDateTime, exit : LocalDateTime, permit : ParkingPermit) : Money
    }

    interface ParkingAction {
        +update(event : ParkingEvent) : void
    }

    class ParkingEvent {
        -type : Type
        -parkingLot : ParkingLot
        -permit : ParkingPermit
        -timestamp : LocalDateTime
        +getType() : Type
        +getParkingLot() : ParkingLot
        +getPermit() : ParkingPermit
        +getTimestamp() : LocalDateTime
    }

    enum ParkingEvent.Type {
        ENTRY
        EXIT
    }

    class ParkingObserver {
        -transactionManager : TransactionManager
        -activeVisits : Map<VisitKey, ParkingEvent>
        +ParkingObserver(transactionManager : TransactionManager, office : ParkingOffice)
        +update(event : ParkingEvent) : void
    }

    interface ParkingChargeStrategy {
        +calculateCharge(baseRate : Money, entry : LocalDateTime, exit : LocalDateTime, permit : ParkingPermit) : Money
    }

    class HourlyParkingChargeStrategy
    class SundayFreeParkingChargeStrategy
    class CompactDiscountParkingChargeStrategy
    interface ParkingChargeStrategyFactory {
        +createStrategy() : ParkingChargeStrategy
    }

    class DefaultParkingChargeStrategyFactory {
        -sundayIsFree : boolean
        +createStrategy() : ParkingChargeStrategy
    }

    class ParkingTransaction {
        -parkingLot : ParkingLot
        -permit : ParkingPermit
        -entryTime : LocalDateTime
        -exitTime : LocalDateTime
        -charge : Money
        ..
        +getCharge() : Money
    }

    class TransactionManager {
        -transactions : List<ParkingTransaction>
        +park(lot : ParkingLot, permit : ParkingPermit, entry : LocalDateTime, exit : LocalDateTime) : ParkingTransaction
        +recordTransaction(transaction : ParkingTransaction) : void
        +getTransactions() : List<ParkingTransaction>
    }

    class ParkingChargeService {
        +calculateCharge(lot : ParkingLot, permit : ParkingPermit, entry : LocalDateTime, exit : LocalDateTime) : Money
    }

    class Address {
        -streetAddress1 : String
        -streetAddress2 : String
        -city : String
        -state : String
        -zip : String
        ..
        +Address(streetAddress1 : String, streetAddress2 : String, city : String, state : String, zip : String)
        +getAddressInfo() : String
    }

    class Customer {
        -id : String
        -firstName : String
        -lastName : String
        -phoneNumber : String
        -address : Address
        ..
        +Customer(id : String, firstName : String, lastName : String, phoneNumber : String, address : Address)
        +getCustomerName() : String
        +getId() : String
        ~assignId(id : String) : void
    }

    class Car {
        -type : CarType
        -licensePlate : String
        -owner : Customer
        ..
        +Car(type : CarType, licensePlate : String, owner : Customer)
        +getType() : CarType
        +getLicensePlate() : String
        +getOwner() : Customer
    }

    class ParkingOffice {
        -customers : Map<String, Customer>
        -cars : Map<String, Car>
        -parkingLots : List<ParkingLot>
        -nextCustomerNumber : int
        -nextPermitNumber : int
        ..
        +ParkingOffice()
        +addParkingLot(parkingLot : ParkingLot) : void
        +getParkingLots() : List<ParkingLot>
        +register(customer : Customer) : String
        +register(car : Car) : String
        +getCustomer(customerId : String) : Customer
        +getCar(permitId : String) : Car
    }

    class ParkingService {
        -office : ParkingOffice
        -commands : Map<String, Command>
        ..
        +ParkingService(office : ParkingOffice)
        -register(command : Command) : void
        +performCommand(commandName : String, parameters : String[]) : String
    }

    class RegisterCustomerCommand {
        -office : ParkingOffice
        ..
        +RegisterCustomerCommand(office : ParkingOffice)
        +getCommandName() : String
        +getDisplayName() : String
        +execute(params : Properties) : String
        -checkParameters(params : Properties) : void
        -require(params : Properties, name : String) : void
    }

    class RegisterCarCommand {
        -office : ParkingOffice
        ..
        +RegisterCarCommand(office : ParkingOffice)
        +getCommandName() : String
        +getDisplayName() : String
        +execute(params : Properties) : String
        -checkParameters(params : Properties) : void
        -require(params : Properties, name : String) : void
    }

    class ParkingApplication {
        +ParkingApplication()
        +{static} main(args : String[]) : void
    }
}

' Interface implementation
RegisterCustomerCommand ..|> Command
RegisterCarCommand ..|> Command
HourlyParkingChargeStrategy ..|> ParkingChargeStrategy
SundayFreeParkingChargeStrategy ..|> ParkingChargeStrategy
CompactDiscountParkingChargeStrategy ..|> ParkingChargeStrategy

' Object relationships and dependencies
ParkingService "1" *-- "2" Command : commands
ParkingService "1" --> "1" ParkingOffice : office
ParkingService ..> RegisterCustomerCommand : creates
ParkingService ..> RegisterCarCommand : creates

RegisterCustomerCommand "1" --> "1" ParkingOffice : office
RegisterCarCommand "1" --> "1" ParkingOffice : office

ParkingOffice "1" o-- "0..*" Customer : customers
ParkingOffice "1" o-- "0..*" Car : cars / permits
ParkingOffice "1" o-- "0..*" ParkingPermit : permits
Car "0..*" --> "0..1" Customer : owner
ParkingPermit "1" --> "1" Car : vehicle
Customer "0..*" --> "0..1" Address : address
Car "0..*" --> "1" CarType : type

ParkingLot "1" --> "1" Money : base rate
ParkingLot "1" --> "1" ParkingChargeStrategyFactory : configures
ParkingLot "1" o-- "0..*" ParkingAction : observers
ParkingLot ..> ParkingEvent : publishes
ParkingObserver ..|> ParkingAction
ParkingAction ..> ParkingEvent : update
ParkingObserver --> TransactionManager : forwards to
ParkingObserver ..> ParkingOffice : subscribes to lots
ParkingOffice "1" o-- "0..*" ParkingLot : lots
ParkingEvent --> ParkingLot : source
ParkingEvent --> ParkingPermit : vehicle
ParkingTransaction "1" --> "1" ParkingLot : lot
ParkingTransaction "1" --> "1" ParkingPermit : permit
TransactionManager ..> ParkingLot : parks in
TransactionManager ..> ParkingChargeStrategyFactory : requests strategy
TransactionManager ..> ParkingTransaction : creates
ParkingChargeService ..> ParkingLot : calculates
ParkingChargeStrategyFactory ..> ParkingChargeStrategy : creates
DefaultParkingChargeStrategyFactory ..|> ParkingChargeStrategyFactory
SundayFreeParkingChargeStrategy ..> ParkingChargeStrategy : delegates
CompactDiscountParkingChargeStrategy ..> ParkingChargeStrategy : decorates

ParkingApplication ..> ParkingOffice : creates
ParkingApplication ..> ParkingService : creates and uses

@enduml
